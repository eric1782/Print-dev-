rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ⚠️ REGLAS TEMPORALES PARA TESTING - REEMPLAZAR CON LAS REGLAS CORRECTAS DESPUÉS
    // Estas reglas permiten todo para probar la funcionalidad
    match /{document=**} {
      allow read, write: if true;
    }
  }
}